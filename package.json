{
  "name": "solicitacoes-trade",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:push": "npm run prisma:push --workspace backend",
    "import:routing": "npm run import:routing --workspace backend",
    "sync:base-rca": "npm run sync:base-rca --workspace backend",
    "solicitacoes-trade:criar-froteirizacao-local": "npm run solicitacoes-trade:criar-froteirizacao-local --workspace backend",
    "dag:solicitacoes-trade:atualizar-base-rca": "npm run dag:solicitacoes-trade:atualizar-base-rca --workspace backend",
    "dag:solicitacoes-trade:atualizar-roteirizacao": "npm run dag:solicitacoes-trade:atualizar-roteirizacao --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
