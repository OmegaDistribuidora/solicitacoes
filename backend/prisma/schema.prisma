generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  SUPERVISOR
}

enum ModuleKey {
  ROUTEIRIZACAO
  ROTA_PROMOTOR
}

enum PromoterRouteRequestAction {
  CREATE
  UPDATE
  DELETE
}

enum PromoterRouteRequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  FAILED
}

enum RouteRequestKind {
  INCLUSAO
  MODIFICACAO
}

enum RouteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RouteRequestItemAction {
  ADD
  UPDATE
}

model User {
  id                            Int                    @id @default(autoincrement())
  username                      String                 @unique
  displayName                   String
  role                          UserRole               @default(SUPERVISOR)
  active                        Boolean                @default(true)
  moduleAccesses                UserModuleAccess[]
  auditLogs                     AuditLog[]
  routeRequests                 RouteRequest[]         @relation("RouteRequester")
  reviewedRequests              RouteRequest[]         @relation("RouteReviewer")
  promoterRouteRequests         PromoterRouteRequest[] @relation("PromoterRouteRequester")
  reviewedPromoterRouteRequests PromoterRouteRequest[] @relation("PromoterRouteReviewer")
  booksCriados                  Book[]                 @relation("BookCriador")
  booksAtualizados              Book[]                 @relation("BookAtualizador")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  @@index([role, active])
}

model Book {
  id               Int            @id @default(autoincrement())
  nome             String         @db.VarChar(200)
  codigoFornecedor Int            @map("codigo_fornecedor")
  periodo          String         @db.VarChar(8)
  dataPeriodo      DateTime       @map("data_periodo") @db.Date
  criadoPorId      Int?           @map("criado_por_id")
  criadoPor        User?          @relation("BookCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPorId  Int?           @map("atualizado_por_id")
  atualizadoPor    User?          @relation("BookAtualizador", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  registros        RegistroBook[]
  anexos           AnexoBook[]
  criadoEm         DateTime       @default(now()) @map("criado_em")
  atualizadoEm     DateTime       @updatedAt @map("atualizado_em")

  @@index([codigoFornecedor])
  @@index([dataPeriodo])
  @@index([criadoEm])
  @@map("books")
}

model RegistroBook {
  id            Int         @id @default(autoincrement())
  bookId        Int         @map("book_id")
  book          Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  promotor      String      @db.VarChar(200)
  codigoCliente Int         @map("codigo_cliente")
  ordem         Int         @default(0)
  anexos        AnexoBook[]
  criadoEm      DateTime    @default(now()) @map("criado_em")
  atualizadoEm  DateTime    @updatedAt @map("atualizado_em")

  @@index([bookId])
  @@index([codigoCliente])
  @@index([promotor])
  @@map("registros_book")
}

model AnexoBook {
  id           Int           @id @default(autoincrement())
  bookId       Int           @map("book_id")
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  registroId   Int?          @map("registro_id")
  registro     RegistroBook? @relation(fields: [registroId], references: [id], onDelete: Cascade)
  tipo         String        @db.VarChar(30)
  nomeOriginal String        @map("nome_original") @db.VarChar(255)
  nomeArquivo  String        @map("nome_arquivo") @db.VarChar(255)
  mimeType     String        @map("mime_type") @db.VarChar(100)
  tamanhoBytes Int           @map("tamanho_bytes")
  caminho      String        @db.VarChar(1000)
  url          String        @db.VarChar(1500)
  criadoEm     DateTime      @default(now()) @map("criado_em")

  @@index([bookId])
  @@index([registroId])
  @@index([tipo])
  @@map("anexos_book")
}

model PromoterRouteEntry {
  sourceId        String    @id @db.Uuid
  codpromotor     String?
  promotor        String?
  areaatuacao     String?
  codcli          Int
  cliente         String?
  frequencia      String?
  dia             String?
  status          String?
  obs             String?
  dataInsercao    DateTime?
  sourceUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([promotor])
  @@index([codcli])
  @@index([dia])
  @@index([status])
}

model PromoterRouteRequest {
  id              Int                        @id @default(autoincrement())
  action          PromoterRouteRequestAction
  status          PromoterRouteRequestStatus @default(PENDING)
  sourceId        String                     @db.Uuid
  requesterUserId Int
  requesterUser   User                       @relation("PromoterRouteRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  reviewerUserId  Int?
  reviewerUser    User?                      @relation("PromoterRouteReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  currentData     Json?
  requestedData   Json?
  reviewReason    String?
  applyError      String?
  reviewedAt      DateTime?
  appliedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([sourceId, status])
  @@index([requesterUserId, createdAt])
}

model UserModuleAccess {
  id              Int       @id @default(autoincrement())
  userId          Int
  module          ModuleKey
  supervisorCodes Int[]     @default([])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, module])
  @@index([module])
}

model AuditLog {
  id               Int       @id @default(autoincrement())
  actorUserId      Int?
  actorUsername    String?
  actorDisplayName String?
  actorRole        UserRole?
  action           String
  entityType       String
  entityId         String?
  summary          String
  before           Json?
  after            Json?
  metadata         Json?
  actorUser        User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model BaseRca {
  id          Int      @id @default(autoincrement())
  codgerente  Int?
  coordenador String?
  codsup      Int
  supervisor  String
  codusur     Int      @unique
  rca         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([codsup])
  @@index([rca])
  @@map("base_rca")
}

model RoutingEntry {
  id            Int      @id @default(autoincrement())
  codgerente    Int?
  coordenador   String?
  codsup        Int
  supervisor    String
  codusur       Int
  rca           String
  codcli        Int
  cliente       String
  dia           String
  tipo          String
  dataAlteracao DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([codusur, codcli])
  @@index([codsup])
  @@index([codusur])
  @@index([dia])
  @@index([tipo])
}

model RouteRequest {
  id              Int                @id @default(autoincrement())
  kind            RouteRequestKind
  status          RouteRequestStatus @default(PENDING)
  requesterUserId Int
  requesterUser   User               @relation("RouteRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  reviewerUserId  Int?
  reviewerUser    User?              @relation("RouteReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  reviewReason    String?
  reviewedAt      DateTime?
  items           RouteRequestItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([requesterUserId, createdAt])
}

model RouteRequestItem {
  id            Int                    @id @default(autoincrement())
  requestId     Int
  request       RouteRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action        RouteRequestItemAction
  codgerente    Int?
  coordenador   String?
  codsup        Int
  supervisor    String
  codusur       Int
  rca           String
  codcli        Int
  cliente       String?
  currentDia    String?
  currentTipo   String?
  requestedDia  String
  requestedTipo String
  createdAt     DateTime               @default(now())

  @@index([requestId])
  @@index([codsup])
  @@index([codusur, codcli])
}
