    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "prisma": "^6.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
